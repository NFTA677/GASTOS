# Copia este archivo como ".env" y rellena tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore): ahí van tus claves.

# ---------- MongoDB: rellena estos datos ----------
# Usuario y contraseña de la base de datos (en Atlas: Database Access)
MONGODB_USER=
MONGODB_PASSWORD=
# Servidor del clúster, sin "mongodb+srv://" (en Atlas: Connect → Drivers), p. ej. cluster0.abcde.mongodb.net
MONGODB_HOST=
# Nombre de la base de datos donde se guardan los gastos
MONGODB_DB=gastos

# Alternativa: la cadena de conexión completa. Si se rellena, tiene prioridad sobre lo anterior.
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.abcde.mongodb.net/gastos

# Si no se rellena nada de MongoDB, la app arranca uno local y guarda los datos en ./data/mongo

# ---------- Servidor ----------
PORT=3000
# En un servidor público con https, pon: NODE_ENV=production
# NODE_ENV=production

# ---------- Administrador ----------
# Correos (separados por comas) que ven la pestaña «Admin» con el almacenamiento.
# Si se deja vacío, el administrador es la primera cuenta que se registró.
# ADMIN_EMAILS=tu-correo@ejemplo.com
# Espacio de tu plan de MongoDB en MB (512 = plan gratuito de Atlas)
# ALMACENAMIENTO_MB=512

# ---------- Bot de WhatsApp e IA ----------
# Zona horaria con la que el bot decide qué día es «hoy»
# ZONA_HORARIA=America/Lima
# Claves para la IA del bot (elige proveedor en Admin → IA). También se pueden guardar desde ese panel.
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=

# ---------- Envío de correo (opcional) ----------
# Sirve para enviar estados de cuenta por correo y el código de «olvidé mi contraseña».
# Dirección desde la que se envía (debe estar verificada en el servicio que uses) y nombre visible:
# CORREO_REMITENTE=avisos@tu-dominio.com
# CORREO_NOMBRE=N.F.T.A Gastos
# Opción A (recomendada en Render gratuito, que bloquea los puertos de correo): clave de la API de Brevo
# BREVO_API_KEY=
# Opción B: un servidor SMTP cualquiera
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Clave para firmar las sesiones. Si falta, se genera sola y se guarda en .env
# En un hosting, defínela tú con un texto largo y aleatorio.
# JWT_SECRET=
